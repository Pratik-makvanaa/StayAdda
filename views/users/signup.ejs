<%= layout("/layouts/boilerplate") %>

<style>
    /* Form Container */
    .signup-form-container {
        background: #ffffff;
        padding: 2.8rem 2.5rem;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        border: 1px solid rgba(226, 232, 240, 0.8);
        margin: 3.5rem auto;
        max-width: 480px;
        font-family: 'Poppins', sans-serif;
        position: relative;
        overflow: hidden;
    }

    .signup-form-container::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 5px;
        background: linear-gradient(90deg, #0284c7, #0ea5e9, #38bdf8);
    }

    .signup-form-container h1 {
        font-size: 2rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 0.5rem;
        text-align: center;
        letter-spacing: -0.02em;
    }

    .signup-subtitle {
        text-align: center;
        color: #64748b;
        font-size: 0.95rem;
        margin-bottom: 2rem;
    }

    .form-label {
        font-size: 0.9rem;
        font-weight: 600;
        color: #334155;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

    .form-control {
        border: 1.5px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.85rem 1.15rem;
        font-size: 0.95rem;
        background-color: #f8fafc;
        transition: all 0.25s ease;
        color: #1e293b;
    }

    .form-control:focus {
        border-color: #0284c7;
        box-shadow: 0 0 0 4px rgba(2, 132, 199, 0.15);
        background-color: #ffffff;
        outline: none;
    }

    .btn-submit-modern {
        background: linear-gradient(135deg, #0284c7, #0369a1);
        border: none;
        padding: 0.9rem 2rem;
        border-radius: 12px;
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        color: #ffffff;
        box-shadow: 0 4px 14px rgba(2, 132, 199, 0.3);
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        width: 100%;
        margin-top: 2rem;
        cursor: pointer;
    }

    .btn-submit-modern:hover {
        background: linear-gradient(135deg, #0369a1, #075985);
        box-shadow: 0 6px 20px rgba(2, 132, 199, 0.4);
        transform: translateY(-2px);
        color: #ffffff;
    }

    .btn-submit-modern:active {
        transform: translateY(0);
    }

    .login-link {
        text-align: center;
        margin-top: 1.75rem;
        color: #64748b;
        font-size: 0.92rem;
    }

    .login-link a {
        color: #0284c7;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .login-link a:hover {
        color: #0369a1;
        text-decoration: underline;
    }

    @media (max-width: 768px) {
        .signup-form-container {
            margin: 2rem 1rem;
            padding: 2rem 1.5rem;
        }

        .signup-form-container h1 {
            font-size: 1.75rem;
        }
    }
</style>

<div class="signup-form-container">
    <h1>Create Account</h1>
    <p class="signup-subtitle">Join StayAdda to book premium stays across India</p>
    <form action="/signup" method="POST" novalidate class="needs-validation">
        <div class="mb-3">
            <label for="username" class="form-label"><i class="fas fa-user text-muted me-1"></i> Username</label>
            <input type="text" class="form-control" id="username" name="username" placeholder="Choose a username" required>
        </div>
        <div class="mb-3">
            <label for="email" class="form-label"><i class="fas fa-envelope text-muted me-1"></i> Email</label>
            <input type="email" class="form-control" id="email" name="email" placeholder="name@example.com" required>
        </div>
        <div class="mb-3">
            <label for="password" class="form-label"><i class="fas fa-lock text-muted me-1"></i> Password</label>
            <input type="password" class="form-control" id="password" name="password" placeholder="Create a strong password" required>
        </div>
        <button type="submit" class="btn-submit-modern">
            <i class="fas fa-user-plus"></i> Sign Up
        </button>
    </form>
    <div class="login-link">
        Already have an account? <a href="/login">Log In</a>
    </div>
</div>
