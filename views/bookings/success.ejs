<%= layout("/layouts/boilerplate") %>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body text-center">
                    <div class="mb-4">
                        <i class="fas fa-check-circle text-success" style="font-size: 4rem;"></i>
                    </div>
                    <h2 class="mb-4">Booking Successful!</h2>
                    <p class="lead mb-4">Your booking has been confirmed. You will receive a confirmation email shortly.</p>
                    <div class="d-grid gap-2">
                        <a href="/bookings" class="btn btn-primary">View My Bookings</a>
                        <a href="/listings" class="btn btn-outline-primary">Browse More Listings</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 