<%= layout("/layouts/boilerplate") %>

<div class="container mt-5">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-4">Search Results for "<%= searchQuery %>"</h2>
            
            <% if(listings.length === 0) { %>
                <div class="alert alert-info">
                    No hotels found matching your search criteria. Try different keywords or browse all listings.
                </div>
                <a href="/listings" class="btn btn-primary">View All Listings</a>
            <% } else { %>
                <div class="row row-cols-1 row-cols-md-3 g-4">
                    <% for(let listing of listings) { %>
                        <div class="col">
                            <div class="card h-100">
                                <div class="card-img-top">
                                    <% if(listing.image) { %>
                                        <img src="<%= listing.image.url %>" class="img-fluid" alt="<%= listing.title %>">
                                    <% } else { %>
                                        <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80" class="img-fluid" alt="Default hotel image">
                                    <% } %>
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title"><%= listing.title %></h5>
                                    <p class="card-text">
                                        <i class="fas fa-map-marker-alt"></i> <%= listing.location %>
                                    </p>
                                    <p class="card-text">
                                        <i class="fas fa-tag"></i> ₹<%= listing.price %> per night
                                    </p>
                                </div>
                                <div class="card-footer">
                                    <a href="/listings/<%= listing._id %>" class="btn btn-primary w-100">View Details</a>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>
</div>

<style>
    .card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: none;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
    }

    .card-img-top {
        height: 200px;
        overflow: hidden;
    }

    .card-img-top img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .card-body {
        padding: 1.5rem;
    }

    .card-title {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
    }

    .card-text {
        color: #666;
        margin-bottom: 0.5rem;
    }

    .card-text i {
        color: #2c3e50;
        margin-right: 0.5rem;
    }

    .card-footer {
        background: none;
        border-top: 1px solid rgba(0, 0, 0, 0.1);
        padding: 1rem 1.5rem;
    }

    .btn-primary {
        background-color: #2c3e50;
        border: none;
        padding: 0.7rem 1.5rem;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        background-color: #1a252f;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(44, 62, 80, 0.15);
    }
</style> 