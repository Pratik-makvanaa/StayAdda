<style>
    /* Premium Modern Navbar */
    .navbar {
        background: rgba(255, 255, 255, 0.88) !important;
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(226, 232, 240, 0.8);
        box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.04);
        padding: 0.85rem 1.5rem;
        position: sticky;
        top: 0;
        z-index: 1000;
        font-family: 'Poppins', -apple-system, sans-serif;
        transition: all 0.3s ease;
    }

    .container {
        max-width: 1360px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .navbar-brand {
        font-size: 1.65rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 0.65rem;
        text-decoration: none;
        letter-spacing: -0.6px;
        padding: 0.25rem 0.5rem;
        background: linear-gradient(135deg, #0284c7 0%, #2563eb 50%, #4f46e5 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent !important;
        transition: all 0.3s ease;
    }

    .navbar-brand .brand-icon-wrap {
        width: 38px;
        height: 38px;
        background: linear-gradient(135deg, #0284c7, #2563eb);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        font-size: 1.15rem;
        box-shadow: 0 4px 12px rgba(2, 132, 199, 0.3);
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .navbar-brand:hover .brand-icon-wrap {
        transform: rotate(-6deg) scale(1.08);
    }

    .nav-link-btn {
        background-color: transparent;
        color: #475569;
        font-weight: 500;
        padding: 0.5rem 1rem;
        border-radius: 9999px;
        transition: all 0.2s ease;
        text-decoration: none;
        font-size: 0.93rem;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    .nav-link-btn:hover {
        background-color: #f1f5f9;
        color: #0284c7;
        transform: translateY(-1px);
    }

    .nav-link-btn.active {
        background-color: #e0f2fe;
        color: #0284c7;
        font-weight: 600;
    }

    /* Modern Pill Buttons */
    .nav-auth-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        padding: 0.55rem 1.25rem;
        border-radius: 9999px;
        font-weight: 600;
        font-size: 0.9rem;
        letter-spacing: 0.2px;
        text-decoration: none;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
        border: 1px solid transparent;
        white-space: nowrap;
    }

    .nav-auth-btn.nav-btn-solid {
        background: linear-gradient(135deg, #0284c7, #2563eb);
        color: #ffffff !important;
        box-shadow: 0 4px 14px rgba(2, 132, 199, 0.3);
    }

    .nav-auth-btn.nav-btn-solid:hover {
        background: linear-gradient(135deg, #0369a1, #1d4ed8);
        color: #ffffff !important;
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(2, 132, 199, 0.4);
    }

    .nav-auth-btn.nav-btn-outline {
        background: #ffffff;
        color: #0284c7 !important;
        border-color: #bae6fd;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
    }

    .nav-auth-btn.nav-btn-outline:hover {
        background: #f0f9ff;
        border-color: #0284c7;
        color: #0369a1 !important;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(2, 132, 199, 0.15);
    }

    .nav-auth-btn.nav-btn-ghost {
        background: transparent;
        color: #475569 !important;
        border-color: #e2e8f0;
    }

    .nav-auth-btn.nav-btn-ghost:hover {
        background: #f8fafc;
        color: #0f172a !important;
        border-color: #cbd5e1;
        transform: translateY(-2px);
    }

    .nav-auth-btn:active {
        transform: translateY(0);
    }

    /* Toggler */
    .navbar-toggler {
        border: 1px solid #e2e8f0;
        padding: 0.5rem 0.65rem;
        border-radius: 10px;
        transition: all 0.2s ease;
    }

    .navbar-toggler:focus {
        outline: none;
        box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.2);
    }

    .navbar-toggler:hover {
        background-color: #f8f9fa;
    }

    /* Navbar Collapse */
    .navbar-collapse {
        transition: all 0.3s ease;
    }

    .navbar-collapse.show {
        background-color: white;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1000;
        padding: 5rem 2rem 2rem;
        overflow-y: auto;
    }

    .navbar-collapse.show .navbar-nav {
        width: 100%;
        text-align: center;
    }

    .navbar-collapse.show .nav-link,
    .navbar-collapse.show .btn {
        opacity: 1;
        transform: translateY(0);
        margin: 0.5rem 0;
        font-size: 1.2rem;
        padding: 0.8rem 1.5rem;
        width: 100%;
        max-width: 300px;
        display: inline-block;
    }

    .mobile-menu-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 1000;
        backdrop-filter: blur(5px);
    }

    .mobile-menu-overlay.show {
        display: block;
    }

    .mobile-menu-close {
        position: fixed;
        top: 1rem;
        right: 1rem;
        background: none;
        border: none;
        color: #2c3e50;
        font-size: 1.5rem;
        cursor: pointer;
        padding: 0.5rem;
        z-index: 1001;
        display: none;
    }

    .mobile-menu-close.show {
        display: block;
    }

    /* Mobile Menu Animation */
    @keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .navbar-collapse.show .nav-link,
    .navbar-collapse.show .btn {
        animation: slideIn 0.3s ease forwards;
    }

    .navbar-collapse.show .nav-link:nth-child(1) { animation-delay: 0.1s; }
    .navbar-collapse.show .nav-link:nth-child(2) { animation-delay: 0.2s; }
    .navbar-collapse.show .btn:nth-child(1) { animation-delay: 0.3s; }
    .navbar-collapse.show .btn:nth-child(2) { animation-delay: 0.4s; }
    .navbar-collapse.show .btn:nth-child(3) { animation-delay: 0.5s; }

    /* Hide page content */
    .page-content-hidden {
        display: none !important;
    }

    /* Responsive Design */
    @media (max-width: 768px) {
        .navbar {
            padding: 0.75rem 1rem;
        }

        .navbar-brand {
            font-size: 1.5rem;
        }

        .navbar .d-flex {
            flex-direction: column;
            align-items: stretch;
            gap: 0.75rem;
            padding: 0.75rem 0;
        }

        .search-in {
            max-width: 100%;
            margin-bottom: 0.5rem;
        }

        .nav-link-btn {
            width: 100%;
            text-align: center;
            padding: 0.8rem 1rem;
            font-size: 1rem;
        }

        .navbar-nav {
            flex-direction: column;
            align-items: stretch;
            gap: 0.75rem;
        }

        .btn {
            width: 100%;
            padding: 0.8rem;
            text-align: center;
            margin: 0.25rem 0;
        }

        .navbar-collapse.show .navbar-nav {
            margin-top: 2rem;
        }

        .navbar-collapse.show .nav-link-btn {
            width: 100%;
            text-align: center;
            margin: 0.5rem 0;
        }

        .nav-auth-btn {
            width: 100%;
            justify-content: center;
            padding: 0.75rem 1rem;
            margin: 0.25rem 0;
        }

        .navbar-collapse.show .btn,
        .navbar-collapse.show .nav-auth-btn {
            width: 100%;
            margin: 0.35rem 0;
        }
    }

    @media (min-width: 769px) {
        .navbar-collapse.show {
            position: static;
            padding: 0;
        }

        .navbar-nav {
            align-items: center;
        }

        .d-flex {
            gap: 1.25rem;
            align-items: center;
        }
    }
</style>

<nav class="navbar navbar-expand-md">
    <div class="container">
        <a class="navbar-brand" href="/">
            <span class="brand-icon-wrap"><i class="fas fa-hotel"></i></span>
            <span>StayAdda</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup"
            aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <button class="mobile-menu-close">
            <i class="fas fa-times"></i>
        </button>

        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
            <div class="navbar-nav me-auto">
                <a class="nav-link nav-link-btn" href="/">Home</a>
                <a class="nav-link nav-link-btn" href="/listings">Explore</a>
                <a class="nav-link nav-link-btn" href="/trip-planner">
                    <i class="fas fa-route me-1"></i>Trip Planner
                </a>
            </div>

            <div class="navbar-nav gap-2 align-items-center">
                <a class="nav-auth-btn nav-btn-outline" href="/listings/new">
                    <i class="fas fa-plus"></i> Add New
                </a>
                <% if(typeof currUser === 'undefined' || !currUser) { %>
                    <a class="nav-auth-btn nav-btn-ghost" href="/login">Log In</a>
                    <a class="nav-auth-btn nav-btn-solid" href="/signup">Sign Up</a>
                <% } else { %>
                    <a class="nav-auth-btn nav-btn-outline" href="/bookings/my-bookings">
                        <i class="fas fa-calendar-check"></i> My Bookings
                    </a>
                    <a class="nav-auth-btn nav-btn-ghost" href="/logout">Log Out</a>
                <% } %>
            </div>
        </div>
    </div>
</nav>

<div class="mobile-menu-overlay"></div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const toggler = document.querySelector('.navbar-toggler');
        const closeBtn = document.querySelector('.mobile-menu-close');
        const collapse = document.querySelector('#navbarNavAltMarkup');
        const heroSection = document.querySelector('.hero-section');

        function toggleMobileMenu(isOpen) {
            if (isOpen) {
                closeBtn.classList.add('show');
                if (heroSection) {
                    heroSection.style.opacity = '0.3';
                }
            } else {
                closeBtn.classList.remove('show');
                if (heroSection) {
                    heroSection.style.opacity = '1';
                }
            }
        }

        toggler.addEventListener('click', () => {
            const isExpanded = collapse.classList.contains('show');
            toggleMobileMenu(!isExpanded);
        });

        closeBtn.addEventListener('click', () => {
            collapse.classList.remove('show');
            toggleMobileMenu(false);
        });

        window.addEventListener('resize', () => {
            if (window.innerWidth > 768) {
                collapse.classList.remove('show');
                toggleMobileMenu(false);
            }
        });

        collapse.addEventListener('hidden.bs.collapse', () => {
            toggleMobileMenu(false);
        });
    });
</script>